// 使用本地已构建的开发镜像；若镜像不存在会先按 Dockerfile.dev 构建
{
  "name": "openlist-episode-renamer-dev",
  "image": "openlist-episode-renamer:dev",
  "dockerFile": "Dockerfile.dev",
  "context": "${workspaceFolder}",
  "containerEnv": {},
  "workspaceFolder": "/work",
  // 端口映射：把容器 8000 暴露到宿主机 http://127.0.0.1:8000；
  // 不要用 --network host——Docker Desktop 下容器在独立虚拟机中，host 模式端口无法暴露给宿主机。
  // host-gateway：让容器内可经 host.docker.internal 访问宿主机上的 OpenList（5244）。
  "runArgs": [
    "-p", "8000:8000",
    "--add-host", "host.docker.internal:host-gateway"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python"
      ]
    }
  },
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": { "label": "Web UI", "onPortForward": "notify" }
  }
}
